  "query": "\n        SELECT g.plate_name, g.unit_price, g.choices, p.content as \"plate_content?\",\n               p.options as \"plate_options?\"\n        FROM event_booking_guests g\n        LEFT JOIN event_plates p ON p.id = g.plate_id\n        WHERE g.booking_id = $1\n        ORDER BY g.position\n        ",
