  "query": "\n        SELECT id, category_id, name, description, price, image_url,\n               is_available, is_featured\n        FROM menu_items\n        WHERE deleted_at IS NULL\n          AND ($1::BIGINT IS NULL OR category_id = $1)\n        ORDER BY display_order, id\n        ",
