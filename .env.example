# DATABASE_URL for the api container is composed from the three POSTGRES_*
# vars below (see docker-compose.yml); a local sqlx/psql session run
# outside Docker (e.g. for `cargo sqlx prepare`) should export the
# equivalent postgres://...@localhost:${POSTGRES_PORT:-5432}/... by hand.
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>
POSTGRES_PORT=5432

MINIO_ROOT_USER=<MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bucket the api container creates (idempotently, on boot) for uploaded menu
# photos. Optional — defaults to "menu-images" if unset.
# MINIO_BUCKET=menu-images

API_PORT=8080
WEB_PORT=3000

DOMAIN=<yourdomain.com>

# apps/api structured logging (see docs/deployment.md "Viewing production
# logs"). RUST_LOG follows tracing-subscriber's EnvFilter syntax
# (module=level comma list); LOG_FORMAT is "json" (prod default) or
# "pretty" (dev default, set explicitly below in docker-compose.yml).
RUST_LOG=info,api=debug,tower_http=debug,sqlx=warn
LOG_FORMAT=pretty

# Email (Phase 17) — Amazon SES SMTP credentials. Leave all five unset in
# local dev to run with email sending disabled (every send becomes a
# logged no-op). Generate SMTP credentials in the SES console (distinct
# from IAM access keys) after verifying a sending domain; see
# docs/deployment.md.
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_USERNAME=<SES_SMTP_USERNAME>
SES_SMTP_PASSWORD=<SES_SMTP_PASSWORD>
EMAIL_FROM_ADDRESS=no-reply@zainstreat.com
EMAIL_BUSINESS_NOTIFY_ADDRESS=orders@zainstreat.com

# Dozzle (browser log viewer, reverse-proxied through Caddy at
# logs.${DOMAIN}, gated by HTTP Basic Auth since it can read every
# container's logs). Generate the hash once with:
#   docker run --rm caddy:2-alpine caddy hash-password
DOZZLE_BASIC_AUTH_USER=<DOZZLE_BASIC_AUTH_USER>
DOZZLE_BASIC_AUTH_HASH=<bcrypt-hash-from-caddy-hash-password>
