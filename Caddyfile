{
	# ACME account email (Phase 21 Decision 17): expiry notices, and lets
	# Caddy fall back to ZeroSSL if Let's Encrypt rate-limits a hostname.
	email {$ACME_EMAIL}
	log {
		format json
	}
}

# Staging sets NOINDEX=true so every site is kept out of search engines
# (Phase 21 Decision 12); production imports the empty snippet.
(noindex-true) {
	header X-Robots-Tag "noindex, nofollow"
}
(noindex-false) {
}

{$DOMAIN} {
	import noindex-{$NOINDEX:false}
	log {
		format json
	}
	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Admin (Phase 21): the same web app; proxy.ts rewrites cms.<host> onto
# app/admin/**. Never indexed.
cms.{$DOMAIN} {
	log {
		format json
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	import noindex-{$NOINDEX:false}
	log {
		format json
	}
	reverse_proxy api:8080
}

logs.{$DOMAIN} {
	import noindex-{$NOINDEX:false}
	basic_auth {
		{$DOZZLE_BASIC_AUTH_USER} {$DOZZLE_BASIC_AUTH_HASH}
	}
	reverse_proxy dozzle:8080
	log {
		format json
	}
}
