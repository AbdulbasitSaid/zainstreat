{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lint-changed-file.sh",
            "timeout": 30,
            "statusMessage": "Linting changed file..."
          }
        ]
      }
    ]
  }
}
