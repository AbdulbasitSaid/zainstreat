{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, customer_name, delivery_type, total, status,\n               created_at as \"created_at: DateTime<Utc>\"\n        FROM orders\n        WHERE ($1::TEXT IS NULL OR status = $1)\n        ORDER BY created_at DESC, id DESC\n        LIMIT $2 OFFSET $3\n        ",
