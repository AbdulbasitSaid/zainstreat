{
	log {
		format json
	}
}

{$DOMAIN} {
	log {
		format json
	}
	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Admin (Phase 21): the same web app; proxy.ts rewrites cms.<host> onto
# app/admin/**. Never indexed.
cms.{$DOMAIN} {
	log {
		format json
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	log {
		format json
	}
	reverse_proxy api:8080
}

logs.{$DOMAIN} {
	basic_auth {
		{$DOZZLE_BASIC_AUTH_USER} {$DOZZLE_BASIC_AUTH_HASH}
	}
	reverse_proxy dozzle:8080
	log {
		format json
	}
}
