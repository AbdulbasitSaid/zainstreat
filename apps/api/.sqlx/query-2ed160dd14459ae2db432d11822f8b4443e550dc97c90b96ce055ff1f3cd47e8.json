  "query": "\n        UPDATE orders\n        SET status = $2,\n            updated_at = now(),\n            payment_confirmed_at = CASE WHEN $2 = 'processing' THEN now() ELSE payment_confirmed_at END\n        WHERE id = $1\n        RETURNING id, customer_name, delivery_type, total, status,\n                  created_at as \"created_at: DateTime<Utc>\"\n        ",
