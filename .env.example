# Local development: copy to .env and fill in.
#
# On servers this file is generated by .github/workflows/_deploy.yml from
# the target GitHub Environment's secrets and variables on every deploy —
# never edit it there (Phase 21). Each key below notes where it lives:
#   [secret] / [var]  = per-Environment (staging, production)
#   [repo var]        = repository variable
#   [deploy]          = set by the workflow itself
#   [local]           = local dev only, not rendered on servers

# DATABASE_URL for the api container is composed from the three POSTGRES_*
# vars below (see docker-compose.yml); a local sqlx/psql session run
# outside Docker (e.g. for `cargo sqlx prepare`) should export the
# equivalent postgres://...@localhost:${POSTGRES_PORT:-5432}/... by hand.
POSTGRES_USER=<POSTGRES_USER>              # [var]
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>      # [secret]
POSTGRES_DB=<POSTGRES_DB>                  # [var]
POSTGRES_PORT=5432                         # [local]

MINIO_ROOT_USER=<MINIO_ROOT_USER>          # [var]
MINIO_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>  # [secret]
MINIO_PORT=9000                            # [local]
MINIO_CONSOLE_PORT=9001                    # [local]
# Bucket the api container creates (idempotently, on boot) for uploaded menu
# photos. Optional — defaults to "menu-images" if unset.
# MINIO_BUCKET=menu-images

API_PORT=8080                              # [local]
WEB_PORT=3000                              # [local]

# [repo var] for production; derived from the IP on staging ([deploy]).
DOMAIN=<yourdomain.com>

# apps/api structured logging (see docs/deployment.md "Viewing production
# logs"). RUST_LOG follows tracing-subscriber's EnvFilter syntax
# (module=level comma list); LOG_FORMAT is "json" (prod default) or
# "pretty" (dev default, set explicitly below in docker-compose.yml).
RUST_LOG=info,api=debug,tower_http=debug,sqlx=warn   # [var]
LOG_FORMAT=pretty                                    # [var]

# Email (Phase 17) — Amazon SES SMTP credentials. Leave all five unset in
# local dev to run with email sending disabled (every send becomes a
# logged no-op). Generate SMTP credentials in the SES console (distinct
# from IAM access keys) after verifying a sending domain; see
# docs/deployment.md.
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com  # [var]
SES_SMTP_USERNAME=<SES_SMTP_USERNAME>                # [secret]
SES_SMTP_PASSWORD=<SES_SMTP_PASSWORD>                # [secret]
EMAIL_FROM_ADDRESS=no-reply@zainstreat.com           # [var]
# [var] — on staging, the developer's address, never the business's.
EMAIL_BUSINESS_NOTIFY_ADDRESS=orders@zainstreat.com
# Base URL for links in emails (Phase 20). Prod compose sets it to
# https://${DOMAIN}, so this only matters locally.
PUBLIC_SITE_URL=http://localhost:3000

# Bank transfer details shown on every invoice (Phase 20). ACCOUNT_NAME and
# IBAN are both required; BIC is optional. Leave unset and invoices tell the
# customer to ask for payment details on WhatsApp instead. An IBAN that fails
# its checksum is treated as unset and logged as an error at startup.
BANK_ACCOUNT_NAME=<BANK_ACCOUNT_NAME>
BANK_IBAN=<BANK_IBAN>
BANK_BIC=
# Optional KvK (Chamber of Commerce) number printed under the bank details.
BUSINESS_KVK=

# Dozzle (browser log viewer, reverse-proxied through Caddy at
# logs.${DOMAIN}, gated by HTTP Basic Auth since it can read every
# container's logs). Generate the hash once with:
#   docker run --rm caddy:2-alpine caddy hash-password
DOZZLE_BASIC_AUTH_USER=<DOZZLE_BASIC_AUTH_USER>             # [var]
# [secret] Store the hash exactly as printed (single `$`, no `$$`): the
# generated .env single-quotes every value, so `$` stays literal.
DOZZLE_BASIC_AUTH_HASH=<bcrypt-hash-from-caddy-hash-password>

# --- Server-only (Phase 21) -------------------------------------------
# Caddy's ACME account email: certificate expiry notices and the ZeroSSL
# fallback when Let's Encrypt rate-limits. [var]
# ACME_EMAIL=you@example.com
# true on staging: every site gets X-Robots-Tag: noindex. [var]
# NOINDEX=false
# Full image refs, set per deploy. [deploy]
# API_IMAGE=ghcr.io/abdulbasitsaid/zainstreat-api:<sha>
# WEB_IMAGE=ghcr.io/abdulbasitsaid/zainstreat-web:<sha>
# Always true on servers. [deploy]
# COOKIE_SECURE=true
